NODEBUG=1

!include <ntwin32.mak>

APP = scream2ew

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: config.obj dispatch.obj ewc.obj gcf.obj \
	gputil.obj main.obj mainloop.obj map.obj scream.obj \
	util.obj
	$(link) $(conlflags) $(ldebug) $(conlibsmt) config.obj \
	dispatch.obj ewc.obj gcf.obj gputil.obj main.obj \
	mainloop.obj map.obj scream.obj util.obj \
	$L\kom.obj $L\getutil.obj $L\socket_ew.obj \
	$L\time_ew.obj $L\chron3.obj $L\logit.obj $L\transport.obj \
	$L\sleep_ew.obj $L\swap.obj -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\scream2ew*
