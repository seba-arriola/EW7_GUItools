#
#                    Nmake File For eqverify and arcfeeder
#                              Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


all:
   emake $B\eqverify.exe
   emake $B\arcfeeder.exe

eqverify:
   emake $B\eqverify.exe

arcfeeder:
   emake $B\arcfeeder.exe

$B\eqverify.exe: eqverify.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) eqverify.obj $L\chron3.obj \
    $L\getutil.obj $L\kom.obj $L\logit.obj $L\sleep_ew.obj $L\time_ew.obj \
    $L\pipe.obj -out:$B\eqverify.exe

$B\arcfeeder.exe: arcfeeder.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) arcfeeder.obj $L\getutil.obj \
      $L\kom.obj $L\pipe.obj $L\sleep_ew.obj -out:$B\arcfeeder.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<

# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\eqverify* $B\arcfeeder*
