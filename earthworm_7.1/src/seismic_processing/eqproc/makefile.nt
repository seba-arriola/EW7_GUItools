#
#                    Nmake File For eqproc and log_everything
#                               Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


all:
   emake $B\eqproc.exe
   emake $B\log_everything.exe

eqproc:
   emake $B\eqproc.exe

log_everything:
   emake $B\log_everything.exe

$B\eqproc.exe: eqproc.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) eqproc.obj $L\site.obj \
    $L\tlay.obj $L\logit.obj $L\time_ew.obj $L\kom.obj $L\chron3.obj \
    $L\mnbrak.obj $L\brent.obj $L\getutil.obj $L\pipe.obj $L\transport.obj \
    $L\rdpickcoda.obj $L\sleep_ew.obj -out:$B\eqproc.exe

$B\log_everything.exe: log_everything.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) log_everything.obj $L\pipe.obj \
      $L\getutil.obj $L\kom.obj -out:$B\log_everything.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<

# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\eqproc* $B\log_everything*
