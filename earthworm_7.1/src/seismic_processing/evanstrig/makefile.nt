#         Nmake File For evanstrig - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

APP = evanstrig
O = $(APP).obj mteltrg.obj mutils.obj compare.obj interpolate.obj 

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\kom.obj \
    $L\getutil.obj $L\time_ew.obj $L\logit.obj $L\transport.obj \
    $L\sleep_ew.obj $L\chron3.obj $L\swap.obj -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) -D_NTSDK $<

# added -D_NTSDK to enable definition of ftime() as _ftime()  LDD.

# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\evanstrig*
