#
#                    Nmake File For eqcoda - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = eqcoda
O = $(APP).obj eqm2_calls.obj stalist.obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\chron3.obj \
    $L\getutil.obj $L\kom.obj $L\logit.obj $L\time_ew.obj $L\pipe.obj \
    -out:$B\$(APP).exe

feedeqcoda:
	emake $B\feedeqcoda.exe
 
$B\feedeqcoda.exe: feedeqcoda.obj
	$(link) $(conlflags) $(ldebug) $(conlibsmt) feedeqcoda.obj $L\getutil.obj \
	$L\kom.obj $L\pipe.obj $L\sleep_ew.obj -out:$B\feedeqcoda.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\eqcoda*
