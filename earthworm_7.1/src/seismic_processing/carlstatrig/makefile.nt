#
#            Nmake File For carlstatrig - Windows NT version
#
APP = carlstatrig

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

!include <ntwin32.mak>

CTOBJS = $(APP).obj \
         addtrace.obj \
         cmprscn.obj \
	 findsta.obj \
	 flushbuf.obj \
	 initpars.obj \
	 initsta.obj \
	 prodstatrg.obj \
	 protrace.obj \
	 readcnfg.obj \
	 readewh.obj \
	 readstas.obj \
	 resetsta.obj \
	 statrpt.obj \
	 updtsta.obj \
	 $L\getutil.obj \
	 $L\kom.obj \
	 $L\logit.obj \
	 $L\sleep_ew.obj \
	 $L\swap.obj \
	 $L\time_ew.obj \
	 $L\transport.obj

compflags= /c /W3 /MT /nologo -D_INTEL

linkflags= /release /nologo

libs= libcmt.lib

$B\$(APP).exe: $(CTOBJS)
   link $(linkflags) $(libs) $(CTOBJS) -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  $(compflags) $(CFLAGS) $(cflags) $(tflags) $<

# Clean-up directives
clean:
    -del a.out core *.o *.obj *% *~

clean_bin:
    -del $B\carlstatrig*
