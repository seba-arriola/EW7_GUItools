#        Nmake File For evansassoc - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

APP = evansassoc
O = $(APP).obj doit.obj list.obj time_dtos.obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\kom.obj \
    $L\getutil.obj $L\time_ew.obj $L\logit.obj $L\transport.obj \
    $L\sleep_ew.obj  -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\evansassoc*
