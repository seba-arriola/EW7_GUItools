#
#                    Nmake File For eqprelim - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = eqprelim
O = $(APP).obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\site.obj $L\tlay.obj \
    $L\logit.obj $L\time_ew.obj $L\kom.obj $L\chron3.obj $L\mnbrak.obj \
    $L\brent.obj $L\getutil.obj $L\pipe.obj $L\rdpickcoda.obj $L\transport.obj $L\sleep_ew.obj \
    -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\eqprelim*
