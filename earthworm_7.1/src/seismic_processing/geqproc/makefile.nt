#
#                    Nmake File For eqfilterII  - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = geqproc

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib
#OL = $(EW_HOME)\$(EW_VERSION)\src\oracle\apps\lib\
OL = 
OLSRC = $(EW_HOME)\$(EW_VERSION)\src\oracle\apps\src\libsrc
O = $(APP).obj $(L)\area.obj

INC = $(EW_HOME)\$(EW_VERSION)\include
#INC = $(INCLUDE)

all: $O $(OL)\arc_2_ewevent.obj $(OL)\init_ewevent.obj $B\$(APP).exe

$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\kom.obj $L\getutil.obj \
   $L\time_ew.obj $L\chron3.obj $L\logit_mt.obj $L\transport.obj \
   $L\sleep_ew.obj $L\mem_circ_queue.obj $L\threads_ew.obj \
   $L\sema_ew.obj $L\read_arc.obj $L\pipe.obj \
   $(OL)arc_2_ewevent.obj $(OL)init_ewevent.obj \
   $L\glevt_2_ewevent.obj $L\global_msg.obj $L\global_loc_rw.obj \
   -out:$B\$(APP).exe

$(OL)\arc_2_ewevent.obj:
	$(cc) $(GLOBALFLAGS)  /nologo /I$(INC) $(cflags) $(cdebug) $(cvarsmt) $(tflags) $(OLSRC)\arc_2_ewevent.c

$(OL)\init_ewevent.obj: 
	$(cc) $(GLOBALFLAGS)  /nologo /I$(INC) $(cflags) $(cdebug) $(cvarsmt) $(tflags) $(OLSRC)\init_ewevent.c

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo /I$(INC) $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\geqproc*
