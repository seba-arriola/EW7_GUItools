###############################
#Set APP to your program name.
###############################
APP = orareport
FULL_APP_NAME = $(EW_BIN)$(APP)$(EXE)

###############################
#Set APP_OBJECTS to your object 
# files
#Set APP_OTHER to any other bind
# options or libraries that you
# need specially for your app.
###############################
APP_OBJECTS =     $(APP).$(OBJ)
				

APP_OTHER = 

###############################
#Set ALL_CLIENT_LIBS to all non DB
# objects needed by your app.
###############################
ALL_CLIENT_LIBS =	$(EW_LIB)transport.$(OBJ) \
   						$(EW_LIB)mem_circ_queue.$(OBJ)  \
						$(EW_LIB)read_arc.$(OBJ) \
						$(EW_LIB)geo_to_km.$(OBJ) \
   						$(APPS_LIB)init_ewevent.$(OBJ) \
						$(APPS_LIB)arc_2_ewevent.$(OBJ) \
						$(APPS_LIB)execute_alarms.$(OBJ) \
						$(APPS_LIB)determine_alarms.$(OBJ) \
						$(APPS_LIB)core_api_utils.$(OBJ) \
						$(APPS_LIB)alarms_api_utils.$(OBJ) \
						$(APPS_LIB)merge_api_utils.$(OBJ) \
						$(APPS_LIB)ewdb_apps_PutDBEventInfo.$(OBJ) \
						$(APPS_LIB)ewdb_apps_GetDBEventInfo.$(OBJ) \
						$(APPS_LIB)ewdb_apps_RetrieveIdChanExternal.$(OBJ) 

