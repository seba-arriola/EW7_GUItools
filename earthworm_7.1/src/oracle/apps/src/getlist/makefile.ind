###############################
#Set APP to your program name.
###############################
APP = getlist
FULL_APP_NAME = $(WEB_BIN)$(APP)$(EXE)

###############################
#Set APP_OBJECTS to your object 
# files
#Set APP_OTHER to any other bind
# options or libraries that you
# need specially for your app.
###############################
APP_OBJECTS = $(APP).$(OBJ) getlist_utils.$(OBJ) config.$(OBJ) get_map_thread.$(OBJ) 
				

APP_OTHER = 

###############################
#Set ALL_CLIENT_LIBS to all non DB
# objects needed by your app.
###############################

ALL_CLIENT_LIBS = 	$(EW_LIB)gd.$(OBJ) \
										$(EW_LIB)gdfontg.$(OBJ) \
										$(EW_LIB)geo_to_km.$(OBJ) \
										$(APPS_LIB)init_ewevent.$(OBJ)  \
										$(APPS_LIB)time_functions.$(OBJ)  \
										$(APPS_LIB)mapserver.$(OBJ) \
										$(APPS_LIB)webparse.$(OBJ) \
										$(APPS_LIB)draw_map.$(OBJ) \
										$(APPS_LIB)html_common.$(OBJ)  \
										$(APPS_LIB)ewdb_apps_GetDBEventInfo.$(OBJ)  \
										$(APPS_LIB)alarms_api_utils.$(OBJ)  
	


