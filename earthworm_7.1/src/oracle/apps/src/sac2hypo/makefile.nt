##################################################################

!include $(APPS_DIR)/src/make_defs.nt

###############################
#Set APP to your program name.
###############################
APP = sac2hypo
FULL_APP_NAME = $(WEB_BIN)$(APP)$(EXE)

###############################
#Set APP_OBJECTS to your object 
# files
#Set APP_OTHER to any other bind
# options or libraries that you
# need specially for your app.
###############################
APP_OBJECTS =     $(APP).$(OBJ)
				

APP_OTHER = 

###############################
#Set ALL_CLIENT_LIBS to all non DB
# objects needed by your app.
###############################
EW_LIB_OBJECTS = \
      $(EW_LIB)chron3.$(OBJ) \
      $(EW_LIB)sacputaway.$(OBJ) \
      $(EW_LIB)swap.$(OBJ) \
      $(EW_LIB)dirops_ew.$(OBJ) \
      $(EW_LIB)logit_mt.$(OBJ) \
      $(EW_LIB)getutil.$(OBJ) \
      $(EW_LIB)kom.$(OBJ) \
      $(EW_LIB)sleep_ew.$(OBJ) \
      $(EW_LIB)time_ew.$(OBJ) \
      $(EW_LIB)read_arc.$(OBJ) \
      $(EW_LIB)socket_ew.$(OBJ) \
      $(EW_LIB)socket_ew_common.$(OBJ) \
      $(EW_LIB)sema_ew.$(OBJ) 

APP_LIB_OBJECTS = \
      $(APPS_LIB)arc_2_ewevent.$(OBJ) \
      $(APPS_LIB)sac_2_ewevent.$(OBJ) \
      $(APPS_LIB)init_ewevent.$(OBJ) \



ALL_CLIENT_LIBS =  $(EW_LIB_OBJECTS) $(APP_LIB_OBJECTS)

!include $(APPS_DIR)/src/make_apps_base.nt
