#
#  This top level makefile creates all station_maintenance subdirectories
#

!include $(APPS_DIR)/src/make_defs.nt

APP_SUB_DIR = station_maintenance

default:
	-md $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)
	-copy *.html         $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)
	nmake nt


clean_nt:
	nmake clean_nt


clean_bin_nt:
	nmake clean_bin_nt


