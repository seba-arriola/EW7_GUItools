#
#                    Nmake File For manual_trigger - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = manual_trigger

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib
A = $(APPS_DIR)/lib

$B\$(APP).exe: $(APP).obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $(APP).obj $L\getutil.obj \
	$L\kom.obj $L\transport.obj $L\sleep_ew.obj $L\parse_trig.obj \
	$L\chron3.obj $L\time_ew.obj $L\logit.obj $L\read_arc.obj \
	$A\arc_2_ewevent.obj $A\init_ewevent.obj  -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\manual_trigger*
