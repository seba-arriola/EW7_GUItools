##################################################################

##############################################
# Makefile for the ewdb apps/libsrc directory
##############################################

.c.obj: 
	$(cc) $(cflags) $<
	copy $@  $(APPS_LIB)

.cpp.$(OBJ):
   $(cc) $(cppflags) $<
	copy $@  $(APPS_LIBCPP)

clean: $(CLEAN_OTHER)
	-del /f core *.o *.obj *% *~

install:
    copy *.$(OBJ) $(APPS_LIB)
