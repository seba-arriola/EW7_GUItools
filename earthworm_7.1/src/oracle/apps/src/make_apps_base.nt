##################################################################

###############################
#This is the include statement
# that links this file to the
# hideous set of makefiles that
# contain all of the DB linking
# logic
###############################

APPS_AND_DOC: $(APP) 
  -md $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)
	-copy $(APP).d $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)\$(APP).d.txt
	-copy programmer_notes.txt $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)
	-copy *.html         $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)
	-copy bugs.txt             $(WEB_DOC_DIR)\EWDB_APPLICATIONS\$(APP_SUB_DIR)

!include $(BASE_DIR)\src\make_ora_api.nt


###############################
#To build objects from .c files
###############################

.c.$(OBJ):
   $(cc) $(cflags) $<

.cpp.$(OBJ):
   $(cc) $(cppflags) $<


#lint doesn't work right now
lint:
	lint $(GLOBALFLAGS)

# cleanup directives
clean:
	-del /F *.obj

clean_bin:
	-del /F $(FULL_APP_NAME)

install:
	
