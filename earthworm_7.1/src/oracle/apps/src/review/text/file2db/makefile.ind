###############################
#Set APP to your program name.
###############################
APP = file2db
FULL_APP_NAME = $(EW_BIN)$(APP)$(EXE)

###############################
#Set APP_OBJECTS to your object 
# files
#Set APP_OTHER to any other bind
# options or libraries that you
# need specially for your app.
###############################
APP_OBJECTS = $(APP).$(OBJ)  
				

APP_OTHER = 

###############################
#Set ALL_CLIENT_LIBS to all non DB
# objects needed by your app.
###############################
ALL_CLIENT_LIBS = 	$(APPS_LIB)arc_2_ewevent.$(OBJ)  \
										$(APPS_LIB)init_ewevent.$(OBJ) \
										$(APPS_LIB)ewdb_apps_ArcFile2DB.$(OBJ)  \
										$(APPS_LIB)ewdb_apps_PutDBEventInfo.$(OBJ) \
										$(APPS_LIB)ewdb_apps_RetrieveIdChanExternal.$(OBJ) \
										$(APPS_LIB)text_review_config.$(OBJ) \
										$(APPS_LIB)html_common.$(OBJ) 

