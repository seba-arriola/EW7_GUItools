###############################
#Set APP to your program name.
###############################
APP = review_other_solutions
FULL_APP_NAME = $(WEB_BIN)$(APP)$(EXE)

###############################
#Set APP_OBJECTS to your object 
# files
#Set APP_OTHER to any other bind
# options or libraries that you
# need specially for your app.
###############################
APP_OBJECTS = $(APP).$(OBJ) 
				

APP_OTHER = 

###############################
#Set ALL_CLIENT_LIBS to all non DB
# objects needed by your app.
###############################

REVIEW_LIBS	= $(APPS_LIB)EQRconfig.$(OBJ) \
				$(APPS_LIB)EQRwebhelper.$(OBJ) 


EW_LIBS = 		$(EW_LIB)gd.$(OBJ) \
							$(EW_LIB)gdfontg.$(OBJ) \
							$(EW_LIB)sacputaway.$(OBJ) \
							$(EW_LIB)geo_to_km.$(OBJ) \
							$(EW_LIB)swap.$(OBJ) \
							$(EW_LIB)dirops_ew.$(OBJ) \
							$(EW_LIB)sac_2_ewevent.$(OBJ) \
							$(EW_LIB)init_ewevent.$(OBJ) \
							$(EW_LIB)arc_2_ewevent.$(OBJ) \
							$(EW_LIB)rw_mag.$(OBJ)

APPS_LIBS = 	$(APPS_LIB)time_functions.$(OBJ)  \
							$(APPS_LIB)mapserver.$(OBJ) \
							$(APPS_LIB)webparse.$(OBJ) \
							$(APPS_LIB)ewdb_apps_GetDBEventInfo.$(OBJ) \
							$(APPS_LIB)draw_map.$(OBJ) \
							$(APPS_LIB)html_common.$(OBJ)  
	
ALL_CLIENT_LIBS = \
							$(REVIEW_LIBS) $(EW_LIBS) $(APPS_LIBS)


