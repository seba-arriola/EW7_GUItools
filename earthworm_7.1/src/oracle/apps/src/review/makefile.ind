###############################
#Set APP to your program name.
###############################
APP = eqreview
FULL_APP_NAME = $(WEB_BIN)$(APP)$(EXE)

###############################
#Set APP_OBJECTS to your object 
# files
#Set APP_OTHER to any other bind
# options or libraries that you
# need specially for your app.
###############################
APP_OBJECTS = $(APP).o 
				

APP_OTHER = 

###############################
#Set ALL_CLIENT_LIBS to all non DB
# objects needed by your app.
###############################

REVIEW_LIBS	= $(REVIEW_LIB)EQRconfig.o $(REVIEW_LIB)EQRwebhelper.o $(REVIEW_LIB)review_function.o


EW_LIBS = 		$(EW_LIB)gd.$(OBJ) \
							$(EW_LIB)gdfontg.$(OBJ) \
							$(EW_LIB)sacputaway.o \
							$(EW_LIB)geo_to_km.o \
							$(EW_LIB)swap.o \
							$(EW_LIB)dirops_ew.o \
							$(EW_LIB)sac_2_ewevent.o 

APPS_LIBS = 	$(APPS_LIB)arc_2_ewevent.$(OBJ) \
							$(APPS_LIB)init_ewevent.$(OBJ) \
							$(APPS_LIB)time_functions.$(OBJ)  \
							$(APPS_LIB)mapserver.$(OBJ) \
							$(APPS_LIB)webparse.$(OBJ) \
							$(APPS_LIB)ewdb_apps_GetDBEventInfo.o \
							$(APPS_LIB)draw_map.$(OBJ) \
							$(APPS_LIB)html_common.$(OBJ)  
	
ALL_CLIENT_LIBS = \
							$(REVIEW_LIBS) $(EW_LIBS) $(APPS_LIBS)


