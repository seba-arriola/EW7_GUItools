##################################################################


###############################
#Include the platform independent makefile
###############################
!include $(APPS_DIR)/src/make_ora_api.ind

###############################
#More ORACLE stuff
###############################
# libraries for linking oci programs
OCILDLIBS= ociw32.lib oci.lib

LDFLAGS=  /LIBPATH:$(ORACLE_HOME)\oci$(ORACLE_OCI_VER)\lib\msvc $(OCILDLIBS)
# Switch \lib\msvc to \lib\borland for borland compiler
 

$(APP): $(ALL_APP_OBJECTS)
   $(link) $(conlflags) $(ldebug) $(LIBC) $(baselibs) $(LDFLAGS) $(ALL_APP_OBJECTS) $(ALL_LIB_OBJECTS) -out:$(FULL_APP_NAME)

