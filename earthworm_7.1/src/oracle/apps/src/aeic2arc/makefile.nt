#
#                    Nmake File For getter - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = aeic2arc

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib
A = $(APPS_DIR)\lib


$B\$(APP).exe: $(APP).obj aeic_2_ewevent.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) \
	$(APP).obj aeic_2_ewevent.obj \
	$L\getutil.obj  $L\kom.obj $L\transport.obj $L\sleep_ew.obj \
	$L\dirops_ew.obj $L\logit.obj $L\time_ew.obj $L\threads_ew.obj \
	$L\sema_ew.obj $L\mem_circ_queue.obj $L\chron3.obj $L\read_arc.obj \
	$A\arc_2_ewevent.obj $A\init_ewevent.obj \
	-out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\aeic2arc*
