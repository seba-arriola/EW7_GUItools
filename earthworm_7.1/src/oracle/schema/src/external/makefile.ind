OBJECTS = ewdb_api_GetIdChanFromStationExternal.$(OBJ) \
          ewdb_api_CreateOrAlterExternalStation.$(OBJ) \
          ewdb_api_SelectExternalStation.$(OBJ) \
          ewdb_api_UH_CreateExternalInfraRecord.$(OBJ) \
          ewdb_api_UH_GetExternalInfraRecord.$(OBJ) 


ALL:  $(OBJECTS)
		-$(COPY) *.$(OBJ) $(EWDB_LIB)
		$(EMAKE_FORCE) sql_scripts

