SQL_DIR = $(SCHEMA_DIR)\sql_scripts

all:	install install_procs

install:
	copy *.sql $(SQL_DIR)
	-copy README* $(SQL_DIR)

install_procs:
	@echo Making in procs
	cd procs
	nmake -f makefile.nt


