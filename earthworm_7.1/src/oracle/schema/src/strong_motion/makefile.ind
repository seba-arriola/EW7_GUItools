#################################################################




API_OBJECTS = \
          ewdb_api_DeleteSMMessage.$(OBJ) \
          ewdb_api_DeleteSMMessagesBeforeTime.$(OBJ) \
          ewdb_api_PutSMMessage.$(OBJ) \
          ewdb_api_GetSMData.$(OBJ) \
          ewdb_api_GetSMDataWithChannelInfo.$(OBJ) 

INTERNAL_OBJECTS = \
          ewdb_internal_CreateSMMotion.$(OBJ) \
          ewdb_internal_GetAllSMMessages.$(OBJ) \
          ewdb_internal_GetSMMessages.$(OBJ) \
          ewdb_internal_GetSMMotionsForMessage.$(OBJ) \
          ewdb_internal_CreateSMMessage.$(OBJ) 


ALL:  $(API_OBJECTS) $(INTERNAL_OBJECTS)
		-$(COPY) *.$(OBJ) $(EWDB_LIB)
		$(EMAKE_FORCE) sql_scripts

