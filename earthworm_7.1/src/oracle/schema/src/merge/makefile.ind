API_OBJECTS = \
          ewdb_api_GetMergeList.$(OBJ) \
          ewdb_api_CreateCoincidence.$(OBJ) \
          ewdb_api_CreateTrigger.$(OBJ) \
          ewdb_api_CreatePhenomenon.$(OBJ) \
          ewdb_api_CreateMerge.$(OBJ) \
          ewdb_api_UpdateMergePreference.$(OBJ) \
          ewdb_api_DeleteMerge.$(OBJ) \
          ewdb_api_DeletePhenomenon.$(OBJ) \
          ewdb_api_GetCoincidence.$(OBJ) \
          ewdb_api_GetTriggerList.$(OBJ) 


INTERNAL_OBJECTS = 	


ALL:  $(API_OBJECTS) $(INTERNAL_OBJECTS)
		-$(COPY) *.$(OBJ) $(EWDB_LIB)
		$(EMAKE_FORCE) sql_scripts
