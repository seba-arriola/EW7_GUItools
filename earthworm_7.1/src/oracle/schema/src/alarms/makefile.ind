OBJECTS = ewdb_api_GetAlarmsRecipientList.$(OBJ) \
          ewdb_api_GetAlarmsRecipientSummary.$(OBJ) \
          ewdb_api_GetAlarmsCriteriaList.$(OBJ) \
          ewdb_api_GetAlarmsFormats.$(OBJ) \
          ewdb_api_GetEmailDeliveries.$(OBJ) \
          ewdb_api_GetEmailRecipient.$(OBJ) \
          ewdb_api_GetPagerDeliveries.$(OBJ) \
		  ewdb_api_GetPagerRecipient.$(OBJ) \
          ewdb_api_GetPhoneDeliveries.$(OBJ) \
		  ewdb_api_GetPhoneRecipient.$(OBJ) \
		  ewdb_api_GetPolygons.$(OBJ) \
		  ewdb_api_GetPolygonVertices.$(OBJ) \
          ewdb_api_GetQddsDeliveries.$(OBJ) \
          ewdb_api_GetCustomDeliveries.$(OBJ) \
          ewdb_api_GetAlarmsRules.$(OBJ) \
          ewdb_api_GetAlarmsAudit.$(OBJ) \
          ewdb_api_GetAndIncrementCubeVersion.$(OBJ) \
		  ewdb_api_GetRecipientSummary.$(OBJ) \
		  ewdb_api_GetRecipientDeliverySummary.$(OBJ) \
		  ewdb_api_GetAlarmsGroupList.$(OBJ) \
		  ewdb_api_GetAlarmsGroupRecipients.$(OBJ) \
          ewdb_api_CreateAlarmAudit.$(OBJ) \
          ewdb_api_CreateAlarmsGroup.$(OBJ) \
          ewdb_api_CreateAlarmsRecipient.$(OBJ) \
          ewdb_api_CreateAlarmsFormat.$(OBJ) \
          ewdb_api_CreateAlarmsRule.$(OBJ) \
          ewdb_api_CreateEmailDelivery.$(OBJ) \
          ewdb_api_CreateGroupRecipient.$(OBJ) \
          ewdb_api_CreatePagerDelivery.$(OBJ) \
          ewdb_api_CreatePhoneDelivery.$(OBJ) \
          ewdb_api_CreateQddsDelivery.$(OBJ) \
		  ewdb_api_CreatePolygon.$(OBJ) \
		  ewdb_api_CreatePolygonVert.$(OBJ) \
          ewdb_api_CreateCustomDelivery.$(OBJ) \
          ewdb_api_CreateAlarmsCriteria.$(OBJ) \
          ewdb_api_DeleteEmailDelivery.$(OBJ) \
          ewdb_api_DeleteGroup.$(OBJ) \
          ewdb_api_DeleteGroupRecipient.$(OBJ) \
          ewdb_api_DeletePagerDelivery.$(OBJ) \
          ewdb_api_DeletePhoneDelivery.$(OBJ) \
          ewdb_api_DeletePolygon.$(OBJ) \
          ewdb_api_DeleteQddsDelivery.$(OBJ) \
          ewdb_api_DeleteCustomDelivery.$(OBJ) \
          ewdb_api_DeleteAlarmsFormat.$(OBJ) \
          ewdb_api_DeleteAlarmsRule.$(OBJ) \
          ewdb_api_DeleteAlarmsRecipient.$(OBJ) \
          ewdb_api_DeleteCritProgram.$(OBJ) \
		  ewdb_api_UpdateRulePolygon.$(OBJ) \
		  ewdb_api_WipeAllAlarmsInfo.$(OBJ)

ALL:  $(OBJECTS)
		-$(COPY) *.$(OBJ) $(EWDB_LIB)
		$(EMAKE_FORCE) sql_scripts

