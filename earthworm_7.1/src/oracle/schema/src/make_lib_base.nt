##################################################################



######################################
# Define common behaviors needed for
# all schema makefiles.
######################################
.c.$(OBJ):
	$(CC) $(cflags) $(INCLUDE_FLAGS) $<

clean:
	$(DELETE_FORCE) *.$(OBJ)

sql_scripts:
	@echo Making in sql_scripts
	cd sql_scripts
	nmake -f makefile.nt
  cd ..


