##################################################################

# Set MS Make Variable NODEBUG based on EW_DEBUG setting
!IF "$(EW_DEBUG)" == "1"
!ELSE
NODEBUG=1
!ENDIF


######################################
# Include the system makefile 
# (ntwin32.mak) so that 
# certain macros like $(CC) work.
######################################
!include <ntwin32.mak>

######################################
# Define the macro definitions that
# we need for all of the schema 
# makefiles.
######################################
COPY = copy
DELETE_FORCE = del /f
EMAKE = nmake -f makefile.nt
EMAKE_FORCE = nmake -a -f makefile.nt
EWDB_LIB= $(SCHEMA_DIR)\lib\  
EW_LIB  = $(EW_HOME)\$(EW_VERSION)\lib\  

###############################
#OBJECT FILES EXTENSION
###############################
OBJ 	= obj

CHEATER_EARTHWORM_PLATFORM_FLAGS = -D_WINNT -D_INTEL 
cflags  = /nologo /W3 $(cdebug) $(cvarsmt) -c $(CHEATER_EARTHWORM_PLATFORM_FLAGS) -I$(SCHEMA_DIR)\src\include -I$(SCHEMA_DIR)\src\include\internal


