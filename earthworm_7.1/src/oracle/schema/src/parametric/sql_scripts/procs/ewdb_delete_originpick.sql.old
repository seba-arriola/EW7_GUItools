CREATE OR REPLACE FUNCTION Delete_OriginPick
(IN_idOriginPick number) RETURN number
as

Temp          number;
Temp_idPick   number;

begin
  select idPick into Temp_idPick from OriginPick 
    where idOriginPick=IN_idOriginPick;
  delete OriginPick where idOriginPick=IN_idOriginPick;
  Temp := Delete_Pick(Temp_idPick, 0/*bForce*/);
  return(0);
EXCEPTION
  WHEN OTHERS THEN
    Temp := SQLCODE;
    if Temp = -2292 then
      return(1);
    else
      insert into test values('Delete_OriginPick',IN_idOriginPick,Temp);
      return(-1);
    end if;
END;
