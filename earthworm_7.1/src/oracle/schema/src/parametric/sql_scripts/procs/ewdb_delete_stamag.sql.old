/*   CHECKED IT OUT USING THE COMMAND CHECKOUT.             */
/*                                                          */


CREATE OR REPLACE FUNCTION Delete_StaMag
(IN_idMagLink number,
 IN_tiMagType number)  RETURN number
as

Temp          number;
Temp_RetCode  number;
begin
  select idDatum into Temp from MagLink where idMagLink=IN_idMagLink;
  delete MagLink where idMagLink=IN_idMagLink;
  if IN_tiMagType = GetTI('CodaDur') then
    Temp_RetCode := Delete_CodaDur(Temp);
  elsif IN_tiMagType = GetTI('PeakAmp') then
    Temp_RetCode := Delete_PeakAmp(Temp,0/*bForce*/);
  else
    insert into test 
      values('DeleteStaMag:Unknown tiMagType',
             IN_idMagLink,IN_tiMagType);
  end if;
  return(0);
EXCEPTION
  WHEN OTHERS THEN
    Temp := SQLCODE;
    if Temp = -2292 then
      return(1);
    else
      insert into test values('Delete_StaMag',IN_idMagLink,Temp);
      return(-1);
    end if;
end;
