#
#                  Nmake File For ringtocoax - Windows NT version
#
APP = ringtocoax
O   = $(APP).obj sender.obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

!include <ntwin32.mak>

compflags= /c /W3 /nologo /DCRTAPI1=_cdecl /D_X86_=1 \
           /DWIN32 /D_MT /MT

linkflags= /NODEFAULTLIB /INCREMENTAL:NO /RELEASE /NOLOGO

libs=      libcmt.lib oldnames.lib kernel32.lib ws2_32.lib \
           mswsock.lib advapi32.lib

$B\$(APP).exe: $O
   link $(linkflags) $(libs) $O $L\kom.obj $L\getutil.obj $L\time_ew.obj \
    $L\logit.obj $L\transport.obj $L\sleep_ew.obj $L\socket_ew.obj \
    -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(compflags) $(cflags) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\ringtocoax*

