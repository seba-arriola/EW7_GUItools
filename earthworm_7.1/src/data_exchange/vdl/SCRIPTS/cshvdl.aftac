#!/bin/csh -f
cd $VDL_DIR
cp $VDL_DIR/PARMS/parms.$VDL_STATION parms
dsklpmom -port 2011 -logpath /export/data/logs/ -parms parms -addr 192.239.137.222
echo "((DSKLPMOM dead at $VDL_STATION.  ))" >! $VDL_DIR/SCRIPTS/vdl.mail
Mail -s "page ketchum" pagemail@nsn4.cr.usgs.gov <$VDL_DIR/SCRIPTS/vdl.mail
Mail -s "vdlmom down " ketchum@usgs.gov <$VDL_DIR/SCRIPTS/vdl.mail
