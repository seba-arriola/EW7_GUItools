#                    Nmake File For ew2file - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

APP = ew2file
O = $(APP).obj
B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

all: $B\$(APP).exe

$B\$(APP).exe: $O
    $(link) $(conlflags) $(ldebug) $(conlibsmt) $O \
    $L\mem_circ_queue.obj $L\kom.obj $L\getsysname_ew.obj $L\getutil.obj \
    $L\logit_mt.obj $L\time_ew.obj $L\threads_ew.obj $L\transport.obj \
    $L\sleep_ew.obj $L\sema_ew.obj $L\dirops_ew.obj -out:$B\ew2file.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<
   

# Clean-up directives
clean:
	-del a.out core *.o *.obj

clean_bin:
	-del $B\$(APP).exe
