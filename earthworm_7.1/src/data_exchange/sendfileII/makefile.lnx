#
#                     Make file for sendfileII
#                         Linux Version
#
CFLAGS = -g

O = sendfileII.o socket_lnx.o config.o chdir_sol.o getfname_sol.o \
    sleep_sol.o log.o tzset_sol.o fopen_sol.o

all: sendfileII

sendfileII: $O
	cc -o sendfileII $O -lm -lc

clean:
	/bin/rm -f sendfileII *.o

clean_bin:
	/bin/rm -f sendfileII 
