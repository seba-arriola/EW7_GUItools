#
#                    Nmake File For coaxtoring - Windows NT version
#
APP=coaxtoring
O=$(APP).obj receiver_nt.obj


B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

!include <ntwin32.mak>


compflags= /c /W3 /MT /nologo

linkflags= /release /nologo

libs= libcmt.lib ws2_32.lib

$B\$(APP).exe: $O
   link $(linkflags) $(libs) $O $L\threads_ew.obj \
    $L\getutil.obj $L\kom.obj $L\logit_mt.obj $L\socket_ew.obj \
    $L\transport.obj $L\sleep_ew.obj $L\time_ew.obj $L\sema_ew.obj \
    -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(compflags) $(cflags) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\coaxtoring*

