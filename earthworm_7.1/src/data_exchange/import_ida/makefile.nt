B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

SUB_DIRS = idatap import_ida

make_sub_dirs:
  @nt_make_subdirs $(SUB_DIRS) 



# Clean-up rules
clean:
	cd idatap
	-del idatap.lib
	cd ..
	cd idatap\src
	-del a.out core *.o *.obj *% *~
	cd ..\..
	cd import_ida 
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\import_ida*
