#                    Nmake File For import_generic - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

all:
	emake import_generic
	emake import_ack

import_generic: import_generic.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) \
    import_generic.obj  $L\threads_ew.obj \
    $L\getutil.obj $L\kom.obj $L\logit_mt.obj $L\socket_ew.obj \
    $L\socket_ew_common.obj $L\transport.obj $L\sleep_ew.obj \
    $L\time_ew.obj $L\sema_ew.obj  -out:$B\import_generic.exe

import_ack: import_ack.obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) \
    import_ack.obj  $L\threads_ew.obj \
    $L\getutil.obj $L\kom.obj $L\logit_mt.obj $L\socket_ew.obj \
    $L\socket_ew_common.obj $L\transport.obj $L\sleep_ew.obj \
    $L\time_ew.obj $L\sema_ew.obj  -out:$B\import_ack.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) -D_NTSDK $<

# added -D_NTSDK to enable definition of getpid() as _getpid() LDD.


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\import_generic* $B\import_ack*
