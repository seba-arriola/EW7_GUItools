#                    Nmake File For ringdup - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

APP = ringdup
O = $(APP).obj
B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib
E = ..\export

all:
	emake ringdup_generic
	emake ringdup_scn

ringdup_generic: $O $E\genericfilter.obj 
    $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $E\genericfilter.obj \
    $L\mem_circ_queue.obj $L\kom.obj $L\getsysname_ew.obj $L\getutil.obj \
    $L\logit_mt.obj $L\time_ew.obj $L\threads_ew.obj $L\transport.obj \
    $L\sleep_ew.obj $L\sema_ew.obj -out:$B\ringdup_generic.exe

ringdup_scn: $O .\scnfilter_exclude.obj 
    $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $E\scnfilter.obj \
    $L\mem_circ_queue.obj $L\kom.obj $L\getsysname_ew.obj $L\getutil.obj \
    $L\logit_mt.obj $L\time_ew.obj $L\threads_ew.obj $L\transport.obj \
    $L\sleep_ew.obj $L\sema_ew.obj $L\swap.obj \
    $L\chron3.obj $L\rdpickcoda.obj \
    -out:$B\ringdup_scn.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<
   

# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\ringdup_generic* $B\ringdup_scn*
