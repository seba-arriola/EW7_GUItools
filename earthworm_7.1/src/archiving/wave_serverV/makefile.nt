#                    Nmake File For wave_serverV - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

APP = wave_serverV
O = $(APP).obj index.obj server_thread.obj serve_trace.obj index_util.obj \
    compare.obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


ALL: $B\$(APP).exe tools

$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug)  $(conlibsmt) $O  \
   $L\getutil.obj $L\kom.obj $L\logit_mt.obj $L\sema_ew.obj $L\mem_circ_queue.obj \
   $L\sleep_ew.obj $L\socket_ew.obj $L\socket_ew_common.obj $L\swap.obj \
   $L\threads_ew.obj $L\time_ew.obj $L\transport.obj  -out:$B\$(APP).exe


.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) /Od $<

tools:: FRC
	cd Tools
	nmake -f makefile.nt
	cd ..


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~
	cd Tools
	nmake -f makefile.nt clean
	cd ..

clean_bin:
	-del $B\wave_serverV*
	-del a.out core *.o *.obj *% *~
	cd Tools
	nmake -f makefile.nt clean_bin


FRC:
