CFLAGS = $(GLOBALFLAGS) -I..

B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib


ALL: inspect_tank read_index read_struct

inspect_tank: inspect_tank.o
	cc -g -o inspect_tank inspect_tank.o

read_index: read_index.o
	cc -g -o read_index read_index.o

read_struct: read_struct.o
	cc -g -o read_struct read_struct.o



.c.o:
	$(CC) $(CFLAGS) -g $(CPPFLAGS) -c  $(OUTPUT_OPTION) $<


# Clean-up rules
clean:
	rm -f a.out core *.o *.obj *% *~

clean_bin:
	rm -f $(ALL)
