CFLAGS = -D_REENTRANT ${GLOBALFLAGS}

B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib


OBJ = trig2disk.o \
      CatPsuedoTrig.o \
      $L/putaway.o \
      $L/ahputaway.o \
      $L/sacputaway.o \
      $L/gseputaway.o \
      $L/seiputaway.o \
      $L/seiutils.o \
      $L/geo_to_km.o \
      $L/sudsputaway.o \
      $L/tankputaway.o \
      $L/logit_mt.o \
      $L/chron3.o \
      $L/dirops_ew.o \
      $L/getutil.o \
      $L/kom.o \
      $L/sleep_ew.o \
      $L/threads_ew.o \
      $L/time_ew.o \
      $L/transport.o \
      $L/socket_ew.o \
      $L/socket_ew_common.o \
      $L/mem_circ_queue.o \
      $L/sema_ew.o \
      $L/parse_trig.o \
      $L/ws_clientII.o \
      $L/swap.o 

trig2disk: $(OBJ); \
	cc -o $(B)/trig2disk $(OBJ) -lpthread -lm

lint:
	lint trig2disk.c CatPsuedoTrig.c $(GLOBALFLAGS)

# Clean-up rules
clean:
	rm -f a.out core *.o *.obj *% *~

clean_bin:
	rm -f $B/trig2disk*
