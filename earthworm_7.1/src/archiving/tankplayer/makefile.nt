#                   Nmake File For tankplayer - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = tankplayer
O = $(APP).obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\getutil.obj \
    $L\kom.obj $L\logit.obj $L\sleep_ew.obj $L\swap.obj \
    $L\time_ew.obj $L\transport.obj -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\tankplayer*
