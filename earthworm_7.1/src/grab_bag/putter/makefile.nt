#
#                    Nmake File For putter - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = putter

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

$B\$(APP).exe: $(APP).obj
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $(APP).obj $L\getutil.obj \
    $L\kom.obj $L\transport.obj $L\sleep_ew.obj -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\putter*
