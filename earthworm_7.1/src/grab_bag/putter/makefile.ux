B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib


putter: putter.o $L/getutil.o $L/kom.o $L/transport.o $L/sleep_ew.o
	cc -o $B/putter putter.o $L/getutil.o $L/kom.o $L/transport.o $L/sleep_ew.o \
	-lm -lpthread


lint:
	lint putter.c $(GLOBALFLAGS)


# Clean-up rules
clean:
	rm -f a.out core *.o *.obj *% *~

clean_bin:
	rm -f $B/putter*
