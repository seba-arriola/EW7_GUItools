#
#                    Nmake File For wsv_test - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = wsv_test
O = $(APP).obj
B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\socket_ew.obj $L\socket_ew_common.obj \
    $L\getutil.obj $L\kom.obj $L\logit.obj $L\time_ew.obj $L\ws_clientII.obj \
    $L\transport.obj $L\sleep_ew.obj -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<

# Clean-up directives
clean:
	del a.out core *.o *.obj *% *~

clean_bin:
	del $B\$(APP)*
