#
#          Nmake File For putpick - Windows NT version
#
NODEBUG=1

!include <ntwin32.mak>

APP = putpick

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

EWBINARIES = $L\chron3.obj $L\getutil.obj $L\kom.obj $L\logit.obj \
             $L\rdpickcoda.obj $L\time_ew.obj $L\transport.obj $L\sleep_ew.obj 

$B\$(APP).exe: $(APP).obj $(EWBINARIES)
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $(APP).obj $(EWBINARIES) \
	 -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\$(APP)*
