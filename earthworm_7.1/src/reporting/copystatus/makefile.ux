B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib

copystatus: copystatus.o $L/getutil.o $L/kom.o $L/sleep_ew.o $L/transport.o $L/errexit.o
	cc -o $B/copystatus copystatus.o $L/getutil.o $L/kom.o $L/transport.o \
          $L/sleep_ew.o $L/errexit.o -lpthread


lint:
	lint copystatus.c $(GLOBALFLAGS)

# Clean-up rules
clean:
	rm -f a.out core *.o *.obj *% *~

clean_bin:
	rm -f $B/copystatus*
