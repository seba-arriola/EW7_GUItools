CFLAGS = -D_REENTRANT $(GLOBALFLAGS)

B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib


CUBIC_MSG = ew2seisvole.o cksum.o $L/logit_mt.o $L/sema_ew.o $L/getutil.o  $L/transport.o $L/kom.o \
		$L/sleep_ew.o $L/time_ew.o

ew2seisvole: $(CUBIC_MSG)
	cc -o $(B)/ew2seisvole $(CUBIC_MSG) -lm -mt  -lpthread

lint:
	lint ew2seisvole.c cksum.c $(GLOBALFLAGS)


# Clean-up rules
clean:
	rm -f a.out core *.o *.obj *% *~

clean_bin:
	rm -f $B/ew2seisvole*
