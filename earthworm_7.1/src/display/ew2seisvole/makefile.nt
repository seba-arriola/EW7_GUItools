#                    Nmake File For ew2seisvole - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

APP = ew2seisvole
O = $(APP).obj cksum.obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O $L\logit_mt.obj \
    $L\getutil.obj $L\transport.obj $L\sleep_ew.obj $L\kom.obj \
    $L\time_ew.obj $L\sema_ew.obj -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\ew2seisvole*
