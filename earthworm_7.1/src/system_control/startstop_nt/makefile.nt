#
#                    Nmake File For startstop_nt
#
NODEBUG=1

!include <ntwin32.mak>

APP=startstop
O=$(APP).obj

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib


$B\$(APP).exe: $O
   $(link) $(conlflags) $(ldebug) $(conlibsmt) $O \
   $L\transport.obj $L\getutil.obj $L\kom.obj $L\logit_mt.obj $L\sema_ew.obj\
    $L\sleep_ew.obj $L\time_ew.obj $L\threads_ew.obj $L\startstop_lib.obj \
    $L\startstop_winlib.obj $L\service_ew.obj $L\lockfile.obj $L\lockfile_ew.obj \
    -out:$B\$(APP).exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<

# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\startstop*
