#                    Nmake File For pau - Windows NT version

NODEBUG=1

!include <ntwin32.mak>

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

OBJS = setflags.obj $L\kom.obj $L\logit.obj $L\dirops_ew.obj $L\getutil.obj \
       $L\transport.obj $L\sleep_ew.obj $L\time_ew.obj

all: 
	emake pau
	emake pidpau 


pau: pau.obj $(OBJS)
   $(link) $(conlflags) $(ldebug) $(conlibsmt) pau.obj $(OBJS) \
     -out:$B\pau.exe

pidpau: pidpau.obj $(OBJS)
   $(link) $(conlflags) $(ldebug) $(conlibsmt) pidpau.obj $(OBJS) \
     -out:$B\pidpau.exe

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) $(cvarsmt) $(tflags) $<


# Clean-up directives
clean:
	-del a.out core *.o *.obj *% *~

clean_bin:
	-del $B\*pau*
