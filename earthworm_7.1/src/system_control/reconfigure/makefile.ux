B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib


O = reconfigure.o $L/dirops_ew.o $L/time_ew.o $L/transport.o $L/sleep_ew.o \
    $L/getutil.o $L/kom.o $L/logit.o 

reconfigure: ${O}
	cc -g -o $B/reconfigure ${O} -lc -lm -lpthread

.c.o:
	cc -c ${CFLAGS} $<

lint:
	lint reconfigure.c $(GLOBALFLAGS)


# Clean-up rules
clean:
	rm -f a.out core *.o *.obj *% *~

clean_bin:
	rm -f $B/reconfigure*
