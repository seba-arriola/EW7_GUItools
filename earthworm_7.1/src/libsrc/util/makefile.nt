#
#                  Nmake File For Utility Routines
#
!IF "$(EW_DEBUG)" == "1"
!ELSE
NODEBUG=1
!ENDIF


!include <ntwin32.mak>

B = $(EW_HOME)\$(EW_VERSION)\bin
L = $(EW_HOME)\$(EW_VERSION)\lib

OBJS =  ahputaway.obj \
	brent.obj \
	butterworth.obj \
	chron3.obj \
	complex_math.obj \
	convertInstResponse.obj \
	fft99.obj \
	fft_prep.obj \
	fleng.obj \
	global_loc_rw.obj \
	global_pick_rw.obj \
	global_amp_rw.obj \
	global_msg.obj \
	gma.obj \
	geo_to_km.obj \
	getutil.obj \
	glevt_2_ewevent.obj \
	gseputaway.obj \
	k2evt2ew.obj \
	kom.obj \
	ioc_filter.obj \
	logit.obj \
	logit_mt.obj \
	lockfile.obj \
	make_triglist.obj \
	mem_circ_queue.obj \
	mnbrak.obj \
	neic2scn.obj \
	parse_trig.obj \
	parse_usnsn.obj \
	priority_queue.obj \
	psn4putaway.obj \
	putaway.obj \
	rdpickcoda.obj \
	read_arc.obj \
	residue.obj \
	rw_mag.obj \
	rw_strongmotion.obj \
	rw_strongmotionII.obj \
	sacputaway.obj \
	seiputaway.obj \
	seiutils.obj \
	site.obj \
	socket_ew_common.obj \
	startstop_lib.obj \
	sudsputaway.obj \
	swap.obj \
	tankputaway.obj \
	tlay.obj \
	transfer.obj \
 	transferFunction.obj \
	trheadconv.obj \
	watchdog_client.obj \
	wave_client.obj \
	ws_clientII.obj \
	ws_clientIIx.obj 



all: $(OBJS) install

logit_mt.obj: logit.c
   $(cc) $(GLOBALFLAGS)  /Fologit_mt.obj /D_LOGITMT $(cflags) $(cdebug) $(cvarsmt) \
         $(tflags) logit.c

.c.obj:
   $(cc) $(GLOBALFLAGS)  /nologo $(cflags) $(cdebug) /D_INTEL $(cvarsmt) $(tflags) $<

install:
   copy *.obj $L
	 nmake -a -f makefile.nt gd_lib


gd_lib:
	nt_comp gd_lib

clean:
	-del a.out core *.o *.obj *% *~


