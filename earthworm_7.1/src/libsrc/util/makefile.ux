CFLAGS = -c -D_REENTRANT $(GLOBALFLAGS) -g

B = $(EW_HOME)/$(EW_VERSION)/bin
L = $(EW_HOME)/$(EW_VERSION)/lib


SRCS = \
	ahputaway.c \
	brent.c \
	chron3.c \
	fft99.c \
	fft_prep.c \
	fleng.c \
	gma.c \
	geo_to_km.c \
	getutil.c \
	global_loc_rw.c \
	global_msg.c \
	gseputaway.c \
	k2evt2ew.c \
	kom.c \
	lockfile.c \
	logit.c \
	make_triglist.c\
	mem_circ_queue.c\
	mnbrak.c \
	neic2scn.c \
	parse_trig.c \
	parse_usnsn.c \
	priority_queue.c \
	putaway.c \
	rdpickcoda.c \
	rayloc_message_rw.c \
	read_arc.c \
	rw_mag.c \
	rw_strongmotion.c \
	rw_strongmotionII.c \
	sacputaway.c \
	seiputaway.c \
	seiutils.c \
	site.c \
	socket_ew_common.c \
	startstop_unix_generic.c \
	startstop_lib.c \
	sudsputaway.c \
	swap.c \
	tankputaway.c \
	tlay.c \
	transfer.c \
	trheadconv.c \
	wave_client.c \
	ws_clientII.c \
	ws_clientIIx.c 

OBJS = $(SRCS:%.c=%.o) logit_mt.o

all: $(OBJS) gd_lib

logit_mt.o: logit.c
	cc -o logit_mt.o $(CFLAGS) -D_LOGITMT logit.c
	cp $@ $L

.c.o:
	cc -c $(CFLAGS) $<
	cp $@ $L

gd_lib::
	(cd gd_lib; make -f makefile.ux)

lint:
	lint $(SRCS) $(GLOBALFLAGS)

clean: 
	/bin/rm -f a.out core *.o *.obj *% *~
	(cd gd_lib; make -f makefile.sol clean)

realclean: clean
	sh -c 'for o in $(OBJS) ;\
	do /bin/rm -f $L/$$o;\
	done'

